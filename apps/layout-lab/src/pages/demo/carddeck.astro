---
import DemoBase from "../../layouts/DemoBase.astro";
import { BRAND, NAV, SERVICES, WORKS, CTA, TAGLINE } from "../../lib/demoContent";

/** The deck: one card per beat. Five is the ceiling before people lose the thread. */
const CARDS = [
  { k: SERVICES[0].n, h: SERVICES[0].title, p: SERVICES[0].body, tone: "green" },
  { k: SERVICES[1].n, h: SERVICES[1].title, p: SERVICES[1].body, tone: "plum" },
  { k: SERVICES[2].n, h: SERVICES[2].title, p: SERVICES[2].body, tone: "gold" },
  { k: "04", h: "Then we leave", p: "Every engagement ends with the files, the rules and a maintainer who can use both without us.", tone: "night" },
];
---

<DemoBase
  slug="carddeck"
  name="Sticky Card Deck (scroll-stack)"
  premise="Four cards that pin and stack on top of each other as you scroll, dealt like a hand."
>
  <style is:global>
    /* The whole effect is position:sticky plus a rising top offset — no script
       at all. Each card sticks a little lower than the one before, so the stack
       stays legible at its edges instead of burying itself. */
    body { background: #E8E6E1; color: #0A0A0A; }

    .bar { position: sticky; top: 0; z-index: 60; display: flex; justify-content: space-between; align-items: center; gap: 18px; flex-wrap: wrap; padding: 15px 22px; background: rgba(232,230,225,0.92); border-bottom: 1px solid #d8d4cb; backdrop-filter: blur(6px); }
    .mark { font-family: "Chakra Petch", system-ui, sans-serif; font-weight: 700; font-size: 18px; }
    .bar ul { list-style: none; display: flex; gap: 16px; margin: 0; padding: 0; font-size: 12.5px; }
    .bar a { color: #5f5a52; text-decoration: none; }
    .bar a:hover { color: #7E3209; }

    .intro { max-width: 900px; margin: 0 auto; padding: 90px 24px 40px; }
    .intro h1 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: clamp(36px, 6.5vw, 74px); line-height: 0.98; margin: 0 0 16px; letter-spacing: -0.02em; }
    .intro p { max-width: 48ch; margin: 0; font-size: 17.5px; line-height: 1.6; color: #3d3a34; }

    .deck { max-width: 900px; margin: 0 auto; padding: 0 24px 20vh; }
    .card {
      position: sticky;
      border-radius: 20px; padding: clamp(28px, 5vw, 54px);
      min-height: 62vh; display: grid; align-content: center; gap: 14px;
      box-shadow: 0 -14px 40px rgba(10,10,10,0.22);
      margin-bottom: 26px;
    }
    /* The staircase. Four cards, four offsets, 26px apart — the same rhythm as
       the gap, so the pile reads as one object. */
    .card:nth-child(1) { top: 86px; }
    .card:nth-child(2) { top: 112px; }
    .card:nth-child(3) { top: 138px; }
    .card:nth-child(4) { top: 164px; }

    .card .k { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11.5px; letter-spacing: 0.24em; text-transform: uppercase; }
    .card h2 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: clamp(28px, 5vw, 52px); line-height: 1; margin: 0; }
    .card p { max-width: 46ch; margin: 0; font-size: 16.5px; line-height: 1.65; }

    .green { background: #042D1D; color: #E8E6E1; }
    .green .k { color: #DCA424; }
    .green p { color: #cfcbc2; }
    .plum { background: #5F2C82; color: #E8E6E1; }
    .plum .k { color: #E4B03E; } /* Goldenrod lifted: the anchor is 4.3:1 on Eminence */
    .plum p { color: #ddd3e6; }
    .gold { background: #DCA424; color: #0A0A0A; }
    .gold .k { color: #5C2507; } /* Sienna deepened: the anchor is 4.0:1 on Goldenrod */
    .night { background: #0A0A0A; color: #E8E6E1; }
    .night .k { color: #DCA424; }
    .night p { color: #cfcbc2; }

    .after { max-width: 900px; margin: 0 auto; padding: 0 24px 110px; }
    .after h2 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: 13px; letter-spacing: 0.24em; text-transform: uppercase; color: #5f5a52; margin: 0 0 18px; }
    .wlist { display: grid; gap: 0; }
    .wrow { display: flex; justify-content: space-between; gap: 16px; padding: 15px 0; border-top: 1px solid #d8d4cb; font-size: 15px; }
    .wrow span:last-child { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 12px; color: #5f5a52; }
    .go { display: inline-block; margin-top: 30px; background: #0A0A0A; color: #E8E6E1; padding: 13px 26px; text-decoration: none; font-family: "Chakra Petch", system-ui, sans-serif; font-weight: 600; border-radius: 999px; }
    .go:hover { background: #7E3209; }

    @media (prefers-reduced-motion: reduce) {
      /* Sticky is not animation, but the pile-up is motion to the reader.
         Asked for less, the deck becomes four plain cards in a row. */
      .card { position: static; min-height: 0; box-shadow: none; }
    }
  </style>

  <header class="bar">
    <span class="mark">{BRAND}</span>
    <nav aria-label="Primary">
      <ul>{NAV.map((n) => <li><a href="#work">{n}</a></li>)}</ul>
    </nav>
  </header>

  <section class="intro">
    <h1>Dealt one<br />card at a time</h1>
    <p>{TAGLINE} Four beats, paced by the scroll so none of them arrives before you are ready for it.</p>
  </section>

  <main class="deck">
    {
      CARDS.map((c) => (
        <article class={"card " + c.tone}>
          <span class="k">{c.k}</span>
          <h2>{c.h}</h2>
          <p>{c.p}</p>
        </article>
      ))
    }
  </main>

  <section class="after" id="work">
    <h2>Selected work</h2>
    <div class="wlist">
      {
        WORKS.map((w) => (
          <div class="wrow">
            <span>{w.client} — {w.line}</span>
            <span>{w.year}</span>
          </div>
        ))
      }
    </div>
    <a class="go" href="#work">{CTA.label}</a>
  </section>
</DemoBase>
