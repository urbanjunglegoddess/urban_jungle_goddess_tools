---
import DemoBase from "../../layouts/DemoBase.astro";
import { BRAND, NAV, CTA, TAGLINE } from "../../lib/demoContent";

/** Each step drives one state of the pinned visual. */
const STEPS = [
  { id: "s1", k: "Week 1", h: "One ferry, one timetable", p: "Harbour Line ran four routes as four separate brands. The first week is spent proving that to the people who run them." },
  { id: "s2", k: "Week 3", h: "The network appears", p: "Once the routes are drawn on one map, the shared parts stop being a theory. The colour system falls out of the geography, not a mood board." },
  { id: "s3", k: "Week 6", h: "Signage before screens", p: "A ferry brand lives on a wet pier at 6am. We set the signage first and let the site inherit from it, never the other way round." },
  { id: "s4", k: "Week 11", h: "Handed over", p: "Four routes, one mark, and a 40-page rule book the operations team can actually argue with." },
];
---

<DemoBase
  slug="scrolly"
  name="Scrollytelling (pinned narrative)"
  premise="A pinned visual on one side, text steps on the other, with the visual changing state as each step arrives."
>
  <style is:global>
    /* The expensive part of scrollytelling is scroll maths that drifts. This
       build has none: an IntersectionObserver watches the steps and sets a
       single data-step attribute. No pixel arithmetic, so nothing to drift. */
    body { background: #0A0A0A; color: #E8E6E1; }

    .bar { position: sticky; top: 0; z-index: 60; display: flex; justify-content: space-between; align-items: center; gap: 18px; flex-wrap: wrap; padding: 14px 22px; background: rgba(10,10,10,0.92); border-bottom: 1px solid #2a2a2a; }
    .mark { font-family: "Chakra Petch", system-ui, sans-serif; font-weight: 700; font-size: 18px; }
    .bar ul { list-style: none; display: flex; gap: 16px; margin: 0; padding: 0; font-size: 12.5px; }
    .bar a { color: #9a958c; text-decoration: none; }
    .bar a:hover { color: #DCA424; }

    .intro { max-width: 1080px; margin: 0 auto; padding: 80px 24px 30px; }
    .intro h1 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: clamp(34px, 6vw, 68px); line-height: 0.98; margin: 0 0 14px; letter-spacing: -0.02em; }
    .intro p { max-width: 48ch; margin: 0; font-size: 17px; line-height: 1.6; color: #cfcbc2; }

    .story { max-width: 1080px; margin: 0 auto; padding: 0 24px 100px; display: grid; gap: 30px; }
    @media (min-width: 860px) { .story { grid-template-columns: 1fr 1fr; align-items: start; } }

    .figure { position: sticky; top: 84px; }
    .scene {
      position: relative; aspect-ratio: 1; border: 1px solid #2a2a2a; border-radius: 16px;
      background: #04140d; overflow: hidden; display: grid; place-items: center;
    }
    .route {
      position: absolute; height: 3px; border-radius: 2px; background: #2f4a3d;
      transition: background 420ms ease, transform 420ms ease, opacity 420ms ease;
      transform-origin: left center;
    }
    .r1 { left: 12%; top: 30%; width: 62%; transform: rotate(9deg); }
    .r2 { left: 16%; top: 48%; width: 54%; transform: rotate(-12deg); }
    .r3 { left: 20%; top: 64%; width: 58%; transform: rotate(5deg); }
    .r4 { left: 10%; top: 78%; width: 46%; transform: rotate(-4deg); }
    .hub {
      position: absolute; width: 16px; height: 16px; border-radius: 50%; background: #DCA424;
      left: 46%; top: 52%; opacity: 0; transition: opacity 420ms ease, transform 420ms ease;
    }
    .plate {
      position: absolute; inset: auto 14px 14px 14px; background: #0A0A0A; border: 1px solid #2a2a2a;
      border-radius: 10px; padding: 12px 14px; opacity: 0; transform: translateY(10px);
      transition: opacity 420ms ease, transform 420ms ease;
      font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11.5px; color: #9a958c; letter-spacing: 0.1em;
    }
    .stamp {
      position: absolute; right: 16px; top: 16px; font-family: "JetBrains Mono", ui-monospace, monospace;
      font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: #DCA424;
    }

    /* --- the four states --- */
    .scene[data-step="s1"] .r1 { background: #5F2C82; }
    .scene[data-step="s2"] .route { background: #DCA424; }
    .scene[data-step="s2"] .hub, .scene[data-step="s3"] .hub, .scene[data-step="s4"] .hub { opacity: 1; }
    .scene[data-step="s3"] .route { background: #DCA424; }
    .scene[data-step="s3"] .plate, .scene[data-step="s4"] .plate { opacity: 1; transform: translateY(0); }
    .scene[data-step="s4"] .route { background: #E8E6E1; }
    .scene[data-step="s4"] .hub { transform: scale(1.5); }

    .steps { display: grid; gap: 10vh; padding: 10vh 0 30vh; }
    /* 0.75, not 0.5. Half opacity reads as "not current" but takes Goldenrod
       to 2.9:1 and the body copy to 3.7:1 on this ground. The border and the
       colour step still mark which one is live. */
    .step { border-left: 2px solid #2a2a2a; padding-left: 20px; transition: border-color 300ms ease, opacity 300ms ease; opacity: 0.75; }
    .step.on { border-left-color: #DCA424; opacity: 1; }
    .step .k { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: #DCA424; }
    .step h2 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: clamp(22px, 3.4vw, 34px); margin: 8px 0 10px; }
    .step p { margin: 0; font-size: 16px; line-height: 1.65; color: #cfcbc2; }

    .end { max-width: 1080px; margin: 0 auto; padding: 0 24px 110px; }
    .go { display: inline-block; background: #E86100; color: #0A0A0A; padding: 13px 26px; text-decoration: none; font-family: "Chakra Petch", system-ui, sans-serif; font-weight: 600; }
    .go:hover { background: #DCA424; }

    @media (max-width: 859px) {
      /* No room to pin beside anything. The scene becomes a fixed illustration
         at the top of the story and the steps read as an ordinary article. */
      .figure { position: static; }
      .steps { gap: 6vh; padding: 6vh 0 10vh; }
      .step { opacity: 1; }
    }
  </style>

  <header class="bar">
    <span class="mark">{BRAND}</span>
    <nav aria-label="Primary">
      <ul>{NAV.map((n) => <li><a href="#story">{n}</a></li>)}</ul>
    </nav>
  </header>

  <section class="intro">
    <h1>Harbour Line,<br />eleven weeks</h1>
    <p>{TAGLINE} This is one project told at the pace it happened.</p>
  </section>

  <div class="story" id="story">
    <div class="figure">
      <div class="scene" id="scene" data-step="s1" role="img" aria-label="Diagram of four ferry routes resolving into one network">
        <span class="stamp" id="stamp">Week 1</span>
        <span class="route r1"></span>
        <span class="route r2"></span>
        <span class="route r3"></span>
        <span class="route r4"></span>
        <span class="hub"></span>
        <span class="plate">HARBOUR LINE · 4 ROUTES · 1 MARK</span>
      </div>
    </div>

    <div class="steps">
      {
        STEPS.map((s) => (
          <section class="step" id={s.id} data-step={s.id}>
            <span class="k">{s.k}</span>
            <h2>{s.h}</h2>
            <p>{s.p}</p>
          </section>
        ))
      }
    </div>
  </div>

  <section class="end">
    <a class="go" href="#story">{CTA.label}</a>
  </section>

  <script>
    /**
     * No scroll maths. An observer with a narrow middle band decides which step
     * is current; the scene reads one attribute and CSS does the rest.
     */
    const scene = document.getElementById("scene") as HTMLElement;
    const stamp = document.getElementById("stamp") as HTMLElement;
    const steps = Array.from(document.querySelectorAll<HTMLElement>(".step"));

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          for (const s of steps) s.classList.toggle("on", s === el);
          scene.dataset.step = el.dataset.step ?? "s1";
          stamp.textContent = el.querySelector(".k")?.textContent ?? "";
        }
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
    );
    for (const s of steps) io.observe(s);
  </script>
</DemoBase>
