---
import DemoBase from "../../layouts/DemoBase.astro";
import { BRAND, NAV, SERVICES, WORKS, STATS, CTA, TAGLINE, INTRO } from "../../lib/demoContent";
---

<DemoBase
  slug="brutal"
  name="Brutalist / Neubrutalism"
  premise="Hard 3px borders, offset solid shadows, clashing fills, no radius anywhere — committed to all the way down."
>
  <style is:global>
    /* Commit fully or it looks unfinished. So: one border width everywhere
       (3px), one shadow offset everywhere (6px), zero border-radius, zero
       gradients, zero opacity. The moment one element softens, the whole page
       reads as a mistake rather than a position. */
    :root { --b: 3px solid #0A0A0A; --sh: 6px 6px 0 #0A0A0A; }
    body { background: #DCA424; color: #0A0A0A; }

    .page { max-width: 1080px; margin: 0 auto; padding: 24px 20px 110px; }

    .bar { display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; border: var(--b); box-shadow: var(--sh); background: #E8E6E1; padding: 12px 16px; }
    .mark { font-family: "Chakra Petch", system-ui, sans-serif; font-weight: 700; font-size: 20px; text-transform: uppercase; letter-spacing: -0.01em; }
    .bar ul { list-style: none; display: flex; gap: 8px; margin: 0; padding: 0; }
    .bar a { display: block; border: var(--b); background: #E8E6E1; padding: 5px 12px; font-size: 13px; font-weight: 600; text-decoration: none; color: #0A0A0A; }
    .bar a:hover { background: #E86100; }

    .hero { border: var(--b); box-shadow: var(--sh); background: #E8E6E1; padding: clamp(24px, 5vw, 52px); margin-top: 26px; }
    .hero h1 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: clamp(38px, 8vw, 92px); line-height: 0.92; margin: 0 0 16px; text-transform: uppercase; letter-spacing: -0.03em; }
    .hero h1 mark { background: #5F2C82; color: #E8E6E1; padding: 0 0.1em; }
    .hero p { max-width: 48ch; margin: 0; font-size: 18px; line-height: 1.5; font-weight: 500; }
    .go { display: inline-block; margin-top: 26px; border: var(--b); box-shadow: var(--sh); background: #E86100; color: #0A0A0A; padding: 13px 26px; font-family: "Chakra Petch", system-ui, sans-serif; font-weight: 700; font-size: 18px; text-transform: uppercase; text-decoration: none; }
    .go:hover { background: #0A0A0A; color: #DCA424; }
    .go:active { transform: translate(6px, 6px); box-shadow: none; }

    h2 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: 15px; text-transform: uppercase; letter-spacing: 0.18em; margin: 50px 0 16px; }

    .grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); }
    .box { border: var(--b); box-shadow: var(--sh); padding: 22px; }
    .box.w { background: #E8E6E1; }
    .box.p { background: #5F2C82; color: #E8E6E1; }
    .box.o { background: #E86100; }
    .box .n { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 13px; font-weight: 500; }
    .box h3 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: 24px; text-transform: uppercase; margin: 8px 0 10px; }
    .box p { margin: 0; font-size: 15px; line-height: 1.5; font-weight: 500; }

    table { width: 100%; border-collapse: collapse; border: var(--b); box-shadow: var(--sh); background: #E8E6E1; }
    th, td { border: var(--b); padding: 11px 14px; text-align: left; font-size: 15px; }
    th { background: #0A0A0A; color: #DCA424; font-family: "Chakra Petch", system-ui, sans-serif; text-transform: uppercase; font-size: 13px; letter-spacing: 0.1em; }

    .stats { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); }
    .stat { border: var(--b); box-shadow: var(--sh); background: #E8E6E1; padding: 18px; }
    .stat .v { font-family: "Chakra Petch", system-ui, sans-serif; font-size: 44px; line-height: 1; }
    .stat .k { font-size: 13px; font-weight: 600; text-transform: uppercase; margin-top: 4px; }

    footer { margin-top: 50px; border: var(--b); box-shadow: var(--sh); background: #0A0A0A; color: #DCA424; padding: 18px; font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 13px; }
  </style>

  <div class="page">
    <header class="bar">
      <span class="mark">{BRAND}</span>
      <nav aria-label="Primary">
        <ul>{NAV.map((n) => <li><a href="#services">{n}</a></li>)}</ul>
      </nav>
    </header>

    <section class="hero">
      <h1>No round<br /><mark>corners</mark> here</h1>
      <p>{TAGLINE} {INTRO}</p>
      <a class="go" href="#services">{CTA.label}</a>
    </section>

    <h2 id="services">What we do</h2>
    <div class="grid">
      {
        SERVICES.map((s, i) => (
          <article class={i === 1 ? "box p" : i === 2 ? "box o" : "box w"}>
            <span class="n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))
      }
    </div>

    <h2>Work</h2>
    <table>
      <thead>
        <tr><th>Client</th><th>Scope</th><th>Year</th></tr>
      </thead>
      <tbody>
        {WORKS.map((w) => <tr><td>{w.client}</td><td>{w.kind}</td><td>{w.year}</td></tr>)}
      </tbody>
    </table>

    <h2>Numbers</h2>
    <div class="stats">
      {
        STATS.map((s) => (
          <div class="stat">
            <div class="v">{s.v}</div>
            <div class="k">{s.k}</div>
          </div>
        ))
      }
    </div>

    <footer>{CTA.address} — {CTA.email}</footer>
  </div>
</DemoBase>
