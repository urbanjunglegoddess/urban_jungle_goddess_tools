---
import DemoBase from "../../layouts/DemoBase.astro";
import { BRAND, NAV, SERVICES, WORKS, STATS, CTA, TAGLINE } from "../../lib/demoContent";
---

<DemoBase
  slug="mondrian"
  name="Mondrian / Irregular Bento Mosaic"
  premise="Uneven colour-blocked cells on a strict grid, held to three accent fills so the mosaic stays composed."
>
  <style is:global>
    /* The sheet's warning is the build rule here: three accent fills, no more —
       Eminence, Goldenrod, Spanish Orange. Everything else is Night, Platinum,
       or the line between them. The irregularity is in the spans, not the palette. */
    body { background: #0A0A0A; color: #E8E6E1; }
    .page { max-width: 1180px; margin: 0 auto; padding: 26px 20px 90px; }

    .bar { display: flex; justify-content: space-between; align-items: center; gap: 18px; flex-wrap: wrap; margin-bottom: 22px; }
    .mark { font-family: "Chakra Petch", system-ui, sans-serif; font-weight: 700; font-size: 19px; }
    .bar ul { list-style: none; display: flex; gap: 18px; margin: 0; padding: 0; font-size: 13px; }
    .bar a { color: #9a958c; text-decoration: none; }
    .bar a:hover { color: #DCA424; }

    .mosaic {
      display: grid; gap: 6px; background: #E8E6E1;
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: 108px; padding: 6px;
    }
    .cell { padding: 18px 20px; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
    .cell.night { background: #0A0A0A; color: #E8E6E1; }
    .cell.plat { background: #E8E6E1; color: #0A0A0A; }
    .cell.emin { background: #5F2C82; color: #E8E6E1; }
    .cell.gold { background: #DCA424; color: #0A0A0A; }
    .cell.orange { background: #E86100; color: #0A0A0A; }

    .c-title { grid-column: span 4; grid-row: span 2; justify-content: center; }
    .c-title h1 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: clamp(30px, 5vw, 62px); line-height: 0.95; margin: 0; letter-spacing: -0.02em; }
    .c-lede { grid-column: span 2; grid-row: span 2; justify-content: center; }
    .c-lede p { margin: 0; font-size: 15px; line-height: 1.5; }
    .c-a { grid-column: span 2; }
    .c-b { grid-column: span 1; }
    .c-c { grid-column: span 3; }
    .c-tall { grid-column: span 2; grid-row: span 2; }
    .c-wide { grid-column: span 4; }

    /* No opacity. Fading the eyebrow by a quarter put it under 4.5:1 on the
       Goldenrod and Spanish Orange cells; size and tracking carry the
       hierarchy instead, and the colour is simply the cell's own ink. */
    .k { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; }
    .v { font-family: "Chakra Petch", system-ui, sans-serif; font-size: 30px; line-height: 1; margin-top: 4px; }
    .cell h3 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: 18px; margin: 6px 0 3px; }
    .cell p.sm { margin: 0; font-size: 13px; line-height: 1.45; }
    a.cell { text-decoration: none; }
    a.cell:hover { filter: brightness(1.12); }

    @media (max-width: 860px) {
      .mosaic { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 128px; }
      .c-title, .c-lede, .c-wide, .c-c, .c-tall, .c-a, .c-b { grid-column: span 2; grid-row: span 1; }
      .c-title { grid-row: span 2; }
    }

    footer { margin-top: 26px; font-size: 13px; color: #9a958c; }
  </style>

  <div class="page">
    <header class="bar">
      <span class="mark">{BRAND}</span>
      <nav aria-label="Primary">
        <ul>{NAV.map((n) => <li><a href="#m">{n}</a></li>)}</ul>
      </nav>
    </header>

    <main class="mosaic" id="m">
      <div class="cell night c-title"><h1>Six cells wide,<br />no two the same</h1></div>
      <div class="cell gold c-lede"><p>{TAGLINE}</p></div>

      <div class="cell emin c-a"><span class="k">{SERVICES[0].title}</span><p class="sm">{SERVICES[0].line}</p></div>
      <div class="cell plat c-b"><span class="k">{STATS[0].k}</span><span class="v">{STATS[0].v}</span></div>
      <div class="cell night c-c"><span class="k">{SERVICES[1].title}</span><p class="sm">{SERVICES[1].line}</p></div>

      <div class="cell orange c-tall"><span class="k">{SERVICES[2].title}</span><h3>{SERVICES[2].title}</h3><p class="sm">{SERVICES[2].body}</p></div>
      <div class="cell plat c-a"><span class="k">{STATS[1].k}</span><span class="v">{STATS[1].v}</span></div>
      <div class="cell night c-a"><span class="k">{STATS[2].k}</span><span class="v">{STATS[2].v}</span></div>

      {
        WORKS.slice(0, 4).map((w, i) => (
          <a class={i % 2 === 0 ? "cell plat c-b" : "cell night c-c"} href="#m">
            <span class="k">{w.year}</span>
            <h3>{w.client}</h3>
            <p class="sm">{w.kind}</p>
          </a>
        ))
      }

      <a class="cell gold c-wide" href="#m"><span class="k">Contact</span><h3>{CTA.label}</h3><p class="sm">{CTA.line}</p></a>
      <div class="cell emin c-a"><span class="k">{STATS[3].k}</span><span class="v">{STATS[3].v}</span></div>
    </main>

    <footer>{CTA.address} · {CTA.email}</footer>
  </div>
</DemoBase>
