---
import DemoBase from "../../layouts/DemoBase.astro";
import { BRAND, NAV, WORKS, SERVICES, CTA, TAGLINE, INTRO } from "../../lib/demoContent";
---

<DemoBase
  slug="asym"
  name="Extreme Asymmetry (80/20)"
  premise="A four-to-one split where the wide side carries everything and the sliver carries only what can be lost."
>
  <style is:global>
    /* The rule the sheet warns about, honoured literally: the 20% rail holds a
       rotated wordmark, a year and a scroll hint. Nothing on it is needed to
       use the page — because on a narrow screen the rail is simply gone. */
    body { background: #0A0A0A; color: #E8E6E1; }

    .shell { display: grid; grid-template-columns: 1fr; min-height: 100vh; }
    @media (min-width: 900px) { .shell { grid-template-columns: 4fr 1fr; } }

    .main { padding: 40px clamp(24px, 5vw, 72px) 110px; }
    .rail {
      display: none; border-left: 1px solid #2a2a2a; background: #042D1D;
      position: sticky; top: 0; height: 100vh;
      flex-direction: column; align-items: center; justify-content: space-between; padding: 28px 0;
    }
    @media (min-width: 900px) { .rail { display: flex; } }
    .rail .vert {
      writing-mode: vertical-rl; font-family: "Chakra Petch", system-ui, sans-serif;
      font-size: 22px; letter-spacing: 0.34em; text-transform: uppercase; color: #DCA424;
    }
    .rail .yr { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; color: #9ab5a8; letter-spacing: 0.2em; }

    .bar { display: flex; justify-content: space-between; align-items: center; gap: 18px; flex-wrap: wrap; }
    .mark { font-family: "Chakra Petch", system-ui, sans-serif; font-weight: 700; font-size: 19px; }
    .bar ul { list-style: none; display: flex; gap: 18px; margin: 0; padding: 0; font-size: 13px; }
    .bar a { color: #9a958c; text-decoration: none; }
    .bar a:hover { color: #DCA424; }

    h1 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: clamp(42px, 8.5vw, 104px); line-height: 0.9; margin: 70px 0 22px; letter-spacing: -0.025em; }
    h1 em { font-style: normal; color: #DCA424; }
    .lede { max-width: 52ch; font-size: 18px; line-height: 1.6; color: #cfcbc2; margin: 0; }
    .go { display: inline-block; margin-top: 30px; background: #E86100; color: #0A0A0A; padding: 13px 26px; font-family: "Chakra Petch", system-ui, sans-serif; font-weight: 600; text-decoration: none; }
    .go:hover { background: #DCA424; }

    h2 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: 13px; letter-spacing: 0.24em; text-transform: uppercase; color: #9a958c; margin: 92px 0 22px; }

    /* The same 80/20 idea repeats inside the content, at row scale. */
    .row { display: grid; gap: 18px; padding: 22px 0; border-top: 1px solid #2a2a2a; }
    @media (min-width: 760px) { .row { grid-template-columns: 4fr 1fr; align-items: baseline; } }
    .row h3 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: clamp(22px, 3vw, 34px); margin: 0 0 6px; }
    .row p { margin: 0; font-size: 14.5px; color: #9a958c; }
    .row .meta { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11.5px; color: #9a958c; letter-spacing: 0.1em; }
    @media (min-width: 760px) { .row .meta { text-align: right; } }

    .svc { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); margin-top: 16px; }
    .s { border: 1px solid #2a2a2a; padding: 22px; }
    .s .n { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 12px; color: #DCA424; }
    .s h3 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: 20px; margin: 7px 0 8px; }
    .s p { margin: 0; font-size: 14px; line-height: 1.55; color: #cfcbc2; }

    footer { margin-top: 110px; padding-top: 20px; border-top: 1px solid #2a2a2a; font-size: 13px; color: #9a958c; }
  </style>

  <div class="shell">
    <div class="main">
      <header class="bar">
        <span class="mark">{BRAND}</span>
        <nav aria-label="Primary">
          <ul>{NAV.map((n) => <li><a href="#work">{n}</a></li>)}</ul>
        </nav>
      </header>

      <h1>Four fifths<br />and <em>a sliver</em></h1>
      <p class="lede">{TAGLINE} {INTRO}</p>
      <a class="go" href="#work">{CTA.label}</a>

      <h2 id="work">Selected work</h2>
      {
        WORKS.map((w) => (
          <article class="row">
            <div>
              <h3>{w.client}</h3>
              <p>{w.line}</p>
            </div>
            <div class="meta">{w.kind}<br />{w.year}</div>
          </article>
        ))
      }

      <h2>Services</h2>
      <div class="svc">
        {
          SERVICES.map((s) => (
            <article class="s">
              <span class="n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </article>
          ))
        }
      </div>

      <footer>{CTA.address} · {CTA.email}</footer>
    </div>

    <aside class="rail" aria-hidden="true">
      <span class="yr">EST 2016</span>
      <span class="vert">{BRAND}</span>
      <span class="yr">ATL</span>
    </aside>
  </div>
</DemoBase>
