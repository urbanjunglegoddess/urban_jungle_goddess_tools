---
import DemoBase from "../../layouts/DemoBase.astro";
import { BRAND, NAV, SERVICES, WORKS, CTA, TAGLINE } from "../../lib/demoContent";
---

<DemoBase
  slug="breakout"
  name="Bento Breakout (cell escapes bounds)"
  premise="A calm bento grid with exactly one tile that bursts past the container edge."
>
  <style is:global>
    /* Two rules make this work and both are the sheet's warnings inverted:
       1. No ancestor of the breakout tile may set overflow:hidden, or the burst
          is simply clipped away. The page reserves side padding instead.
       2. One breakout, once. A second one is not a wow beat, it is noise. */
    body { background: #E8E6E1; color: #0A0A0A; }
    .page { max-width: 1100px; margin: 0 auto; padding: 26px 24px 110px; }

    .bar { display: flex; justify-content: space-between; align-items: center; gap: 18px; flex-wrap: wrap; }
    .mark { font-family: "Chakra Petch", system-ui, sans-serif; font-weight: 700; font-size: 19px; }
    .bar ul { list-style: none; display: flex; gap: 18px; margin: 0; padding: 0; font-size: 13px; }
    .bar a { color: #5f5a52; text-decoration: none; }
    .bar a:hover { color: #7E3209; }

    h1 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: clamp(34px, 6vw, 64px); line-height: 0.98; margin: 52px 0 14px; letter-spacing: -0.02em; }
    .lede { max-width: 50ch; margin: 0 0 44px; font-size: 17px; line-height: 1.55; color: #3d3a34; }

    .bento {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
      /* deliberately NOT overflow:hidden — see note above */
    }
    .tile {
      background: #fbfaf7; border: 1px solid #d8d4cb; border-radius: 14px; padding: 22px;
      display: flex; flex-direction: column; gap: 8px;
    }
    .tile .k { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: #7E3209; }
    .tile h3 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: 19px; margin: 0; }
    .tile p { margin: 0; font-size: 14px; line-height: 1.5; color: #3d3a34; }
    .t-a { grid-column: span 2; }
    .t-b { grid-column: span 1; }
    .t-c { grid-column: span 3; }

    /* The one that escapes. It widens past the page's own max-width using
       viewport units, and lifts off the page with a heavy shadow so the burst
       reads as depth rather than as a layout error. */
    .burst {
      grid-column: 1 / -1;
      position: relative;
      width: calc(100vw - 32px);
      max-width: none;
      left: 50%;
      transform: translateX(-50%);
      background: #042D1D; color: #E8E6E1;
      border: none; border-radius: 18px;
      padding: clamp(28px, 5vw, 56px);
      box-shadow: 0 30px 70px rgba(4, 45, 29, 0.42);
      overflow: hidden;
    }
    .burst .k { color: #DCA424; }
    .burst h2 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: clamp(28px, 5vw, 54px); line-height: 1; margin: 10px 0 12px; }
    .burst p { max-width: 54ch; margin: 0; color: #cfcbc2; font-size: 16px; line-height: 1.6; }
    .burst .go { display: inline-block; margin-top: 24px; background: #DCA424; color: #0A0A0A; padding: 12px 24px; font-family: "Chakra Petch", system-ui, sans-serif; font-weight: 600; text-decoration: none; border-radius: 999px; }
    .burst .go:hover { background: #E8E6E1; }
    .burst .glow { position: absolute; right: -70px; top: -70px; width: 300px; height: 300px; border-radius: 50%; background: radial-gradient(circle, rgba(220,164,36,0.28), transparent 70%); }

    @media (max-width: 800px) {
      .bento { grid-template-columns: 1fr; }
      .t-a, .t-b, .t-c { grid-column: 1 / -1; }
      /* At this width the page is already edge-to-edge, so the tile stops
         bursting and simply becomes the loudest block in the stack. */
      .burst { width: auto; left: auto; transform: none; }
    }

    footer { margin-top: 70px; padding-top: 18px; border-top: 1px solid #d8d4cb; font-size: 13px; color: #5f5a52; }
  </style>

  <div class="page">
    <header class="bar">
      <span class="mark">{BRAND}</span>
      <nav aria-label="Primary">
        <ul>{NAV.map((n) => <li><a href="#b">{n}</a></li>)}</ul>
      </nav>
    </header>

    <h1>One tile refuses<br />to stay in the box</h1>
    <p class="lede">{TAGLINE}</p>

    <main class="bento" id="b">
      {
        SERVICES.map((s, i) => (
          <article class={i === 0 ? "tile t-a" : "tile t-b"}>
            <span class="k">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.line}</p>
          </article>
        ))
      }

      <section class="burst">
        <div class="glow" aria-hidden="true"></div>
        <span class="k">The one beat</span>
        <h2>{CTA.label}</h2>
        <p>{CTA.line}</p>
        <a class="go" href="#b">{CTA.email}</a>
      </section>

      {
        WORKS.slice(0, 3).map((w, i) => (
          <article class={i === 2 ? "tile t-b" : "tile t-b"}>
            <span class="k">{w.year}</span>
            <h3>{w.client}</h3>
            <p>{w.line}</p>
          </article>
        ))
      }
      <article class="tile t-b">
        <span class="k">Studio</span>
        <h3>Six people</h3>
        <p>No account managers, no handover deck.</p>
      </article>
    </main>

    <footer>{CTA.address} · {CTA.email}</footer>
  </div>
</DemoBase>
