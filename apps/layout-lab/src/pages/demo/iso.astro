---
import DemoBase from "../../layouts/DemoBase.astro";
import { BRAND, SERVICES, STATS, CTA, TAGLINE } from "../../lib/demoContent";

const PLANES = [
  { k: "Layer 3", h: SERVICES[2].title, p: SERVICES[2].line, tone: "gold" },
  { k: "Layer 2", h: SERVICES[1].title, p: SERVICES[1].line, tone: "plum" },
  { k: "Layer 1", h: SERVICES[0].title, p: SERVICES[0].line, tone: "green" },
];
---

<DemoBase
  slug="iso"
  name="Isometric 3D Sections"
  premise="Panels on an isometric plane stacked in faux-3D — a fixed illustration with a flat, honest fallback."
>
  <style is:global>
    /* The sheet is blunt: this does not reflow, it is essentially a fixed
       illustration, and it is heavy to change later. Both are respected here.
       The isometric transform is applied only above 900px and only through one
       shared matrix; the same markup below that width is a plain stack, and the
       text never lives inside the transform where it would be sheared. */
    body { background: #060a08; color: #E8E6E1; }
    .wrap { max-width: 1080px; margin: 0 auto; padding: 24px 22px 120px; }

    .bar { display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; }
    .mark { font-family: "Chakra Petch", system-ui, sans-serif; font-weight: 700; font-size: 18px; }
    .bar .k { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: #9ab5a8; }

    h1 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: clamp(32px, 5.6vw, 60px); line-height: 1; margin: 46px 0 12px; letter-spacing: -0.02em; }
    .lede { max-width: 48ch; margin: 0; font-size: 17px; line-height: 1.6; color: #b9cec4; }

    .scene { margin: 60px 0 0; display: grid; gap: 18px; }
    .plane {
      border: 1px solid #1e3329; border-radius: 12px; padding: 22px 24px;
      display: flex; gap: 18px; align-items: baseline; justify-content: space-between; flex-wrap: wrap;
    }
    .plane.green { background: #042D1D; }
    .plane.plum { background: #2a1339; }
    .plane.gold { background: #4a3a10; }
    .plane .k { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: #DCA424; }
    .plane h2 { font-family: "Chakra Petch", system-ui, sans-serif; font-size: 24px; margin: 6px 0 4px; }
    .plane p { margin: 0; font-size: 14.5px; color: #cfcbc2; max-width: 40ch; }

    @media (min-width: 900px) {
      /* One matrix, three offsets. Text is counter-transformed back to flat so
         no letterform is ever sheared — the plates are isometric, the words
         are not. */
      .scene { margin-top: 110px; gap: 0; perspective: none; }
      .plane {
        transform: rotateX(56deg) rotateZ(-45deg);
        transform-style: preserve-3d;
        width: 560px; margin: -70px auto 0; padding: 34px;
        box-shadow: -26px 26px 0 rgba(0,0,0,0.4);
        justify-content: flex-start; align-items: flex-start; flex-direction: column; gap: 4px;
      }
      .plane:nth-child(1) { margin-top: 0; }
      .plane > .txt { transform: rotateZ(45deg) rotateX(-56deg); transform-origin: left top; }
      .plane p { max-width: 34ch; }
      .scene { padding-bottom: 180px; }
    }

    h3.sec { font-family: "Chakra Petch", system-ui, sans-serif; font-size: 13px; letter-spacing: 0.24em; text-transform: uppercase; color: #9ab5a8; margin: 70px 0 16px; }
    .stats { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
    .stat { border: 1px solid #1e3329; border-radius: 10px; padding: 18px; }
    .stat .v { font-family: "Chakra Petch", system-ui, sans-serif; font-size: 36px; line-height: 1; color: #DCA424; }
    .stat .k { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: #9ab5a8; margin-top: 6px; }
    .go { display: inline-block; margin-top: 30px; background: #DCA424; color: #060a08; padding: 13px 26px; text-decoration: none; font-family: "Chakra Petch", system-ui, sans-serif; font-weight: 600; }
    .go:hover { background: #E8E6E1; }
  </style>

  <div class="wrap">
    <header class="bar">
      <span class="mark">{BRAND}</span>
      <span class="k">How it works</span>
    </header>

    <h1>Three planes,<br />one stack</h1>
    <p class="lede">{TAGLINE} Above 900 pixels the plates tilt onto an isometric plane; below it they are three ordinary cards, because this drawing does not reflow.</p>

    <div class="scene">
      {
        PLANES.map((p) => (
          <section class={"plane " + p.tone}>
            <div class="txt">
              <span class="k">{p.k}</span>
              <h2>{p.h}</h2>
              <p>{p.p}</p>
            </div>
          </section>
        ))
      }
    </div>

    <h3 class="sec">The studio</h3>
    <div class="stats">
      {
        STATS.map((s) => (
          <div class="stat">
            <div class="v">{s.v}</div>
            <div class="k">{s.k}</div>
          </div>
        ))
      }
    </div>

    <a class="go" href="#">{CTA.label}</a>
  </div>
</DemoBase>
